# ─────────────────────────────────────────────────────────────
# DevMate AI v3 — Environment Variables
# Copy this to .env and fill ALL values before running
# ─────────────────────────────────────────────────────────────

# Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# MongoDB Atlas URI
# Get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://your_mongodb_connection_string

# JWT Secrets — use long random strings (min 32 chars)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5500

# Gmail App Password for OTP emails
# Guide: myaccount.google.com > Security > 2-Step > App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# GitHub Token (optional — prevents rate limits)
GITHUB_TOKEN=

# File upload
MAX_FILE_SIZE_MB=5
